# Copy to frontend/.env.local. Everything here is PUBLIC (it reaches the browser) — never put secrets here.

# Empty = the browser calls /api on the same origin and Next forwards it to the backend (needed for one public link).
NEXT_PUBLIC_API_URL=

# Firebase web app config (from: firebase apps:sdkconfig WEB <app-id>)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudflare Turnstile SITE key (the secret goes in backend/.env). Empty = no bot check shown.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
