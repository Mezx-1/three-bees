# Copy to backend/.env and fill in. Never commit the real .env.
# Every key is optional: without it the feature reports "Not configured" — results are never faked.

# ---- AI (optional). Without a key 3B runs its built-in checks only and says so in every report.
ANTHROPIC_API_KEY=
THREEB_AI_MODEL=claude-opus-5-5
GEMINI_API_KEY=
THREEB_GEMINI_MODEL=gemini-2.5-flash
# claude | gemini — which one to use when both keys are set
THREEB_AI_PROVIDER=claude

# ---- Link reputation (sent only when external lookups are switched on with consent in Settings)
URLHAUS_AUTH_KEY=
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
ABUSEIPDB_API_KEY=

# ---- Firebase Authentication (only the project ID is needed to verify sign-in tokens)
FIREBASE_PROJECT_ID=

# ---- Cloudflare
# Turnstile secret (bot check on Report a Scam). The matching SITE key goes in frontend/.env.local.
CLOUDFLARE_TURNSTILE_SECRET_KEY=
# The public link shown on the Integrations page (e.g. the cloudflared tunnel URL)
THREEB_PUBLIC_URL=

# DNS + IP geolocation lookups default (can also be toggled in Settings, which also records consent)
THREEB_EXTERNAL_LOOKUPS=false

THREEB_MAX_UPLOAD_MB=25
THREEB_RATE_LIMIT_PER_MINUTE=60
THREEB_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# THREEB_DATABASE_URL=postgresql+psycopg://threebees:threebees@localhost/threebees   (SQLite file by default)
