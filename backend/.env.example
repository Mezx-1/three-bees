# Copy to backend/.env and fill in. Never commit the real .env.

# Claude AI analysis (optional). Without it WOLVE runs deterministic-only and says so in every report.
ANTHROPIC_API_KEY=
WOLVE_AI_MODEL=claude-opus-5-5

# Optional threat-intel providers (absent = "not configured", never faked)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# DNS + IP geolocation lookups (send the looked-up indicator to those services). Can also be toggled in Settings.
WOLVE_EXTERNAL_LOOKUPS=true

WOLVE_MAX_UPLOAD_MB=25
WOLVE_RATE_LIMIT_PER_MINUTE=60
WOLVE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# WOLVE_DATABASE_URL=postgresql+psycopg://wolve:wolve@localhost/wolve   (SQLite file by default)
